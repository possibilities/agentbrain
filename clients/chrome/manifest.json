{
  "manifest_version": 3,
  "name": "Agentbrain Share",
  "version": "1.3.0",
  "description": "Send the current page, a link, or a selection to your private Agentbrain share ingress; holds shares while it is unreachable and shows what became of each one.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "128": "icon128.png" },
  "action": {
    "default_title": "Agentbrain shares",
    "default_icon": { "128": "icon128.png" },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "share-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Send the current page to Agentbrain"
    }
  }
}
