{
  "name": "agentbrain",
  "version": "0.1.0",
  "description": "Expose Mike's local research cache through an agent-friendly Bun CLI",
  "private": true,
  "type": "module",
  "bin": {
    "agentbrain": "src/cli.ts"
  },
  "scripts": {
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.12",
    "bun-types": "^1.3.12",
    "typescript": "^5.9.0"
  }
}
