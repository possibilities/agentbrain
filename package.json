{
  "name": "agentbrain",
  "version": "0.2.0",
  "description": "Own and expose Mike's local research index through an agent-friendly Bun CLI",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "bin": {
    "agentbrain": "src/cli.ts"
  },
  "scripts": {
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=1 --max-concurrency=1 --timeout=30000",
    "check": "bun run typecheck && bun run lint && bun run test",
    "test:gate": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.12",
    "bun-types": "^1.3.12",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  }
}
